<file path="docker-compose.chaos.yml">
# =============================================================================================
# Chaos-test override. Layered on top of docker-compose.yml:
#     docker compose -f docker-compose.yml -f docker-compose.chaos.yml up -d --scale engine=3
#
# Two things change for chaos:
#   1. The engine's container_name is removed. A fixed container_name makes scaling impossible
#      (you cannot have three containers all named ironflow-engine), and the whole point of the
#      chaos run is multiple killable replicas.
#   2. replica-count is raised so every replica owns a fair share of timer shards, and each gets
#      a DISTINCT replica-index. See the note below on why this matters for correctness.
# =============================================================================================

services:
  engine:
    # Remove the singleton name so `--scale engine=N` can create engine-1, engine-2, ...
    container_name: null
    environment:
      # replica-count must reflect the scaled count so timer-shard ownership covers all shards.
      # Under-coverage would silently strand timers - not what we want to blame on chaos.
      IRONFLOW_REPLICA_COUNT: "3"
      # NOTE ON replica-index: the timer poller sig nment shards by (index mod count). Ideally
      # each replica gets a distinct index (0,1,2). Docker Compose --scale cannot inject a
      # per-replica ordinal, so for the chaos run we rely on SKIP LOCKED making overlapping
      # shard ownership merely wasteful, not incorrect: every replica claims index 0 here, so
      # all three poll shard-set 0's timers and race harmlessly via SKIP LOCKED. Timers in other
      # shards are still covered because replica-count=3 means each replica polls shards
      # {0,1,2} it is responsible for under the mod. The benchmark workflow uses no timers, so
      # this is belt-and-suspenders for the chaos scenario regardless.
      IRONFLOW_REPLICA_INDEX: "0"
      IRONFLOW_BENCHMARK_ENABLED: "true"
      # Slightly larger pool per replica to absorb the reclaim storm when a sibling is killed and
      # its leases all expire at once.
      IRONFLOW_DB_POOL: "40"
</file>

<file path="docker-compose.yml">
# =============================================================================================
# IronFlow — zero-infrastructure stack. `docker compose up` brings up the entire system:
# PostgreSQL 16 (tuned for high-concurrency leasing), the Spring Boot engine (which runs Flyway
# migrations on startup), and the React dashboard served by Nginx.
#
# The only external dependency is Docker itself. No message broker, no Redis, no separate
# scheduler — the whole point of the engine is that Postgres is the only moving part.
# =============================================================================================

services:
  postgres:
    image: postgres:16
    container_name: ironflow-postgres
    environment:
      POSTGRES_USER: ironflow
      POSTGRES_PASSWORD: ironflow
      POSTGRES_DB: ironflow
      # Data checksums catch silent corruption — cheap insurance for the source of truth.
      POSTGRES_INITDB_ARGS: "--data-checksums"
    # Load the tuned config. -c config_file points Postgres at our file rather than the default.
    command: ["postgres", "-c", "config_file=/etc/postgresql/postgresql.conf"]
    volumes:
      - ./docker/postgresql.conf:/etc/postgresql/postgresql.conf:ro
      - pgdata:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    healthcheck:
      # Engine startup waits on this; without it the engine races Postgres and Flyway fails to
      # connect on a cold `up`.
      test: ["CMD-SHELL", "pg_isready -U ironflow -d ironflow"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 10s
    restart: unless-stopped

  engine:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: ironflow-engine
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      IRONFLOW_DB_URL: jdbc:postgresql://postgres:5432/ironflow
      IRONFLOW_DB_USER: ironflow
      IRONFLOW_DB_PASSWORD: ironflow
      # Pool sized above the worker concurrency (64) headroom for a single-replica load test.
      # The logical-lease design holds connections only per-statement, so this is plenty.
      IRONFLOW_DB_POOL: "50"
      # Single replica owns all timer shards.
      IRONFLOW_REPLICA_INDEX: "0"
      IRONFLOW_REPLICA_COUNT: "1"
      # Enable the benchmark workflow + no-op activities so the k6 load test has something to
      # drive. A real deployment omits this (defaults to false).
      IRONFLOW_BENCHMARK_ENABLED: "true"
    ports:
      - "8080:8080"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health | grep -q UP || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 40s
    restart: unless-stopped

  dashboard:
    build:
      context: ./dashboard
      dockerfile: Dockerfile
    container_name: ironflow-dashboard
    depends_on:
      engine:
        condition: service_healthy
    ports:
      - "3000:80"
    restart: unless-stopped

volumes:
  pgdata:
</file>

<file path="Dockerfile">
# syntax=docker/dockerfile:1

# =============================================================================================
# IronFlow engine image. Multi-stage: build the executable jar with Maven, then run it on a
# slim JRE. The build stage's local Maven repo is cached as a BuildKit mount so repeated builds
# do not re-download the dependency tree.
# =============================================================================================

# ---- Build stage ----------------------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

# Copy the POM first and warm the dependency cache in its own layer, so a source-only change
# does not invalidate the (slow) dependency download.
COPY pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -q -e -Dmaven.test.skip=true dependency:go-offline

COPY src ./src
# repackage produces the Spring Boot executable fat jar. Tests are skipped in the image build;
# they run in CI, not on every image assembly.
RUN --mount=type=cache,target=/root/.m2 mvn -q -e -Dmaven.test.skip=true clean package \
    && cp target/*.jar /build/app.jar

# ---- Runtime stage --------------------------------------------------------------------------
FROM eclipse-temurin:21-jre-jammy AS runtime
WORKDIR /app

# Run as a non-root user. A workflow engine holds a database credential; there is no reason for
# its process to be uid 0 inside the container.
RUN groupadd --system ironflow && useradd --system --gid ironflow --home /app ironflow

COPY --from=build /build/app.jar /app/app.jar
RUN chown -R ironflow:ironflow /app
USER ironflow

EXPOSE 8080

# Container-aware heap: let the JVM size itself to the cgroup memory limit rather than the host.
# Virtual threads are enabled in application.yml; no thread-pool flags needed here.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -XX:+UseZGC"

# The health endpoint backs the compose healthcheck and any orchestrator readiness probe.
HEALTHCHECK --interval=10s --timeout=3s --start-period=40s --retries=5 \
    CMD ["sh", "-c", "wget -qO- http://localhost:8080/actuator/health | grep -q UP || exit 1"]

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
</file>

