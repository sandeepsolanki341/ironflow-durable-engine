<file path="docker/postgresql.conf">
# =============================================================================================
# IronFlow PostgreSQL 16 tuning for high-concurrency task leasing.
#
# The workload is unusual and the tuning reflects it: very short transactions, extremely high
# commit rate, heavy contention on a few hot rows (the queue) mediated by SELECT ... FOR UPDATE
# SKIP LOCKED, and LISTEN/NOTIFY fan-out. This is NOT an OLAP or a read-heavy config; every
# setting below is chosen for "thousands of tiny version-bumped writes per second".
#
# Sized for a container with ~4 GB RAM. Scale shared_buffers / effective_cache_size with the
# host. Values are intentionally explicit rather than relying on defaults, so the throughput
# number the load test reports is reproducible.
# =============================================================================================

# ---- Connections ----------------------------------------------------------------------------
# The engine pools at IRONFLOW_DB_POOL (default 30) PER replica, plus the LISTEN connections and
# headroom for psql/admin. 200 covers several engine replicas without exhausting backends. Going
# much higher is counterproductive: each backend is a process, and past the core count you want
# a pooler (PgBouncer), not more Postgres backends.
max_connections = 200

# ---- Memory ---------------------------------------------------------------------------------
shared_buffers = 1GB                 # ~25% of a 4GB container
effective_cache_size = 3GB           # planner hint: assume the OS caches the rest
work_mem = 16MB                      # per sort/hash node; the queue queries are tiny, but joins
                                     # in the dashboard list benefit
maintenance_work_mem = 256MB         # faster VACUUM/index builds
huge_pages = try

# ---- Write-ahead log: the throughput lever --------------------------------------------------
# This is where a leasing workload lives or dies. Every state transition is a commit, so WAL
# write behaviour is the ceiling.
wal_level = replica
synchronous_commit = off             # THE big one. At ~5-10k commits/sec, waiting for each
                                     # commit's WAL flush to disk dominates. 'off' lets commits
                                     # return before the flush, trading a <1s window of
                                     # last-transactions-on-crash for a multiple-x throughput
                                     # gain. Safe for a workflow engine because the design
                                     # already assumes at-least-once activity execution and
                                     # replays from history - a handful of lost commits on a
                                     # hard crash re-derive on recovery. Set to 'on' only if you
                                     # cannot tolerate that window.
wal_writer_delay = 200ms
wal_compression = lz4
max_wal_size = 4GB                   # fewer checkpoints under sustained write load
min_wal_size = 1GB
checkpoint_completion_target = 0.9   # spread checkpoint I/O to avoid write stalls
checkpoint_timeout = 15min

# ---- Background writer ----------------------------------------------------------------------
bgwriter_delay = 50ms
bgwriter_lru_maxpages = 400

# ---- Query planner --------------------------------------------------------------------------
random_page_cost = 1.1               # assume SSD; the queue index scans are random-access
effective_io_concurrency = 200       # SSD can service many concurrent I/Os

# ---- Autovacuum: critical for a high-churn queue table --------------------------------------
# wf_tasks is churned hard - rows inserted, leased (updated), completed (updated), and deleted
# or aged out constantly. Without aggressive autovacuum the table bloats and the SKIP LOCKED
# scan slows as it steps over dead tuples. These settings make autovacuum wake often and work
# hard specifically because the hot table demands it.
autovacuum = on
autovacuum_max_workers = 4
autovacuum_naptime = 10s
autovacuum_vacuum_scale_factor = 0.05     # vacuum at 5% dead tuples, not the 20% default
autovacuum_analyze_scale_factor = 0.02
autovacuum_vacuum_cost_delay = 2ms        # let it keep up with churn rather than throttling

# ---- Parallelism ----------------------------------------------------------------------------
# The hot path is thousands of tiny single-row queries; parallel workers help the dashboard's
# aggregate/list queries but must not steal from the transactional load. Keep modest.
max_worker_processes = 8
max_parallel_workers = 4
max_parallel_workers_per_gather = 2

# ---- LISTEN/NOTIFY --------------------------------------------------------------------------
# The engine leans on NOTIFY for both task dispatch and the SSE event stream. Defaults are fine;
# the notification queue is a fixed cluster resource and the design treats delivery as
# best-effort, so no tuning knob is needed here - noted explicitly so nobody "optimizes" it.

# ---- Logging: keep quiet under load ---------------------------------------------------------
# Logging every one of thousands of statements per second would make the log the bottleneck.
log_min_duration_statement = 500ms   # only log genuinely slow statements
log_checkpoints = on
log_lock_waits = on                  # DO log lock waits: contention is what we care about here
log_line_prefix = '%m [%p] %q%u@%d '

# ---- Statement timeout safety net -----------------------------------------------------------
# No single engine query should run for seconds. A runaway is a bug; fail it rather than let it
# pin a backend. The engine's own decision-timeout is separate and shorter.
statement_timeout = 30000            # 30s hard ceiling
idle_in_transaction_session_timeout = 60000
