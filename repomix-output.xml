<file path="dashboard/nginx.conf">
# IronFlow dashboard: serves the SPA and proxies API traffic to the engine on the compose
# network. One origin for the browser, so no CORS.

upstream ironflow_engine {
    # 'engine' is the compose service name; Docker's embedded DNS resolves it.
    server engine:8080;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA history-mode routing: any non-file path falls back to index.html so client-side
    # routes resolve on a hard refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets get a long cache; index.html must not, or clients pin a stale bundle.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # REST API -> engine.
    location /api/ {
        proxy_pass http://ironflow_engine;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Server-Sent Events stream needs buffering OFF and a long read timeout, or Nginx will
    # batch the event frames and starve the live DAG - the single most common SSE-behind-Nginx
    # bug. These three lines are what make the stream actually stream.
    location ~ ^/api/v1/executions/[^/]+/stream$ {
        proxy_pass http://ironflow_engine;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering "no";
    }

    # Actuator (telemetry charts read from here).
    location /actuator/ {
        proxy_pass http://ironflow_engine;
        proxy_set_header Host $host;
    }
}
</file>

